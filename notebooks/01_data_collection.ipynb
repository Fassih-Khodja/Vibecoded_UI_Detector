   "source": [
    "# 🖼️ Website Screenshot Dataset Builder (Colab Edition)\n",
    "\n",
    "This notebook builds an image dataset of website screenshots from `projects.json` for training a computer vision model that detects AI-generated (\"vibe-coded\") websites.\n",
    "\n",
    "**What it does:**\n",
    "- Visits each `live_url` with a real Chromium browser via Playwright\n",
    "- Takes screenshots at multiple scroll positions (desktop + mobile)\n",
    "- Outputs a CSV with metadata linking each image to its source project\n",
    "- Saves all PNGs to a flat `./dataset/` folder\n",
    "\n",
    "**Upload your `projects.json` first** (drag & drop into the Files panel on the left)."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1️⃣ Install Dependencies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install Playwright and browser binaries\n",
    "!pip install playwright pandas --quiet\n",
    "!playwright install chromium\n",
    "print(\"✅ Playwright + Chromium ready\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2️⃣ Configuration & Imports\n",
    "\n",
    "Adjust these settings to control the dataset."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import argparse\n",
    "import asyncio\n",
    "import json\n",
    "import random\n",
    "import re\n",
    "import sys\n",
    "import csv\n",
    "import os\n",
    "from pathlib import Path\n",
    "from datetime import datetime\n",
    "from dataclasses import dataclass, asdict\n",
    "from typing import List, Dict, Optional\n",
    "\n",
    "import pandas as pd\n",
    "from playwright.async_api import async_playwright, TimeoutError as PWTimeoutError\n",
    "\n",
    "# ═══════════════════════════════════════════════════════════\n",
    "# CONFIGURATION — tweak these values\n",
    "# ═══════════════════════════════════════════════════════════\n",
    "\n",
    "INPUT_FILE = \"projects.json\"          # Your uploaded JSON file\n",
    "OUTPUT_DIR = \"./dataset\"              # Where screenshots go\n",
    "CSV_FILE = \"./dataset_metadata.csv\"   # Master metadata file\n",
    "\n",
    "MIN_SHOTS = 4                         # Min screenshots per site\n",
    "MAX_SHOTS = 7                         # Max screenshots per site\n",
    "MOBILE_RATIO = 0.32                   # ~32% mobile screenshots\n",
    "CONCURRENCY = 4                       # Parallel sites\n",
    "TIMEOUT = 30000                       # Page load timeout (ms)\n",
    "LIMIT = None                          # Set to N to only process first N sites\n",
    "HEADLESS = True                       # False = visible browser window\n",
    "\n",
    "DESKTOP_VIEWPORTS = [\n",
    "    {\"width\": 1920, \"height\": 1080},\n",
    "    {\"width\": 1536, \"height\": 864},\n",
    "    {\"width\": 1440, \"height\": 900},\n",
    "    {\"width\": 1366, \"height\": 768},\n",
    "    {\"width\": 1280, \"height\": 800},\n",
    "]\n",
    "\n",
    "MOBILE_DEVICES = [\n",
    "    \"iPhone 13\",\n",
    "    \"iPhone 12 Pro\",\n",
    "    \"iPhone SE\",\n",
    "    \"Pixel 5\",\n",
    "    \"Galaxy S9+\",\n",
    "]\n",
    "\n",
    "FILENAME_RE = re.compile(r\"^(?P<slug>.+)_(?P<mode>desktop|mobile)_(?P<idx>\d+)\\.png$\")\n",
    "COUNTERS = {}\n",
    "\n",
    "print(\"✅ Configuration loaded\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3️⃣ Helper Functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "@dataclass\n",
    "class ScreenshotRecord:\n",
    "    \"\"\"One row in the output CSV.\"\"\"\n",
    "    filename: str\n",
    "    slug: str\n",
    "    mode: str          # desktop | mobile\n",
    "    index: int\n",
    "    url: str\n",
    "    scroll_y: int\n",
    "    viewport_width: int\n",
    "    viewport_height: int\n",
    "    device_name: str   # empty for desktop\n",
    "    captured_at: str\n",
    "    status: str        # ok | timeout | error\n",
    "\n",
    "\n",
    "def sanitize(name: str) -> str:\n",
    "    \"\"\"Make a string safe to use as (part of) a filename.\"\"\"\n",
    "    name = name.strip().lower()\n",
    "    name = re.sub(r\"[^a-z0-9_-]+\", \"-\", name)\n",
    "    name = re.sub(r\"-{2,}\", \"-\", name).strip(\"-_\")\n",
    "    return name or \"site\"\n",
    "\n",
    "\n",
    "def load_websites(path: str):\n",
    "    \"\"\"Load the list of website dicts, tolerating a few common JSON shapes.\"\"\"\n",
    "    data = json.loads(Path(path).read_text(encoding=\"utf-8\"))\n",
    "    if isinstance(data, list):\n",
    "        return data\n",
    "    if isinstance(data, dict):\n",
    "        for key in (\"websites\", \"data\", \"items\", \"results\", \"entries\"):\n",
    "            val = data.get(key)\n",
    "            if isinstance(val, list):\n",
    "                return val\n",
    "        if data and all(isinstance(v, dict) for v in data.values()):\n",
    "            return list(data.values())\n",
    "    raise ValueError(\n",
    "        \"Could not find a list of website entries in the JSON file. \"\n",
    "        \"Expected a top-level array, or an object with a 'websites'/'data'/\"\n",
    "        \"'items' list.\"\n",
    "    )\n",
    "\n",
    "\n",
    "def init_counters(output_dir: Path):\n",
    "    for f in output_dir.glob(\"*.png\"):\n",
    "        m = FILENAME_RE.match(f.name)\n",
    "        if not m:\n",
    "            continue\n",
    "        key = (m.group(\"slug\"), m.group(\"mode\"))\n",
    "        idx = int(m.group(\"idx\"))\n",
    "        COUNTERS[key] = max(COUNTERS.get(key, 0), idx)\n",
    "\n",
    "\n",
    "def next_index(slug: str, mode: str) -> int:\n",
    "    key = (slug, mode)\n",
    "    COUNTERS[key] = COUNTERS.get(key, 0) + 1\n",
    "    return COUNTERS[key]\n",
    "\n",
    "\n",
    "def pick_scroll_positions(max_scroll: int, viewport_h: int, count: int):\n",
    "    \"\"\"Pick `count` roughly evenly-spaced, jittered scroll-Y offsets.\"\"\"\n",
    "    if max_scroll < max(40, viewport_h * 0.1):\n",
    "        return [0]\n",
    "\n",
    "    fractions = [0.0] if count <= 1 else [i / (count - 1) for i in range(count)]\n",
    "    positions = []\n",
    "    for frac in fractions:\n",
    "        jitter = random.uniform(-0.04, 0.04)\n",
    "        f = min(1.0, max(0.0, frac + jitter))\n",
    "        positions.append(int(f * max_scroll))\n",
    "\n",
    "    positions = sorted(set(positions))\n",
    "    min_gap = max(40, int(viewport_h * 0.15))\n",
    "    deduped = []\n",
    "    for y in positions:\n",
    "        if not deduped or y - deduped[-1] >= min_gap:\n",
    "            deduped.append(y)\n",
    "    return deduped\n",
    "\n",
    "print(\"✅ Helpers defined\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4️⃣ Core Screenshot Engine"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "async def capture_viewport(\n",
    "    browser, pw, slug, url, mode, count,\n",
    "    timeout, headless, out_dir: Path\n",
    ") -> List[ScreenshotRecord]:\n",
    "    \"\"\"Open one browser context, navigate once, take up to `count` screenshots.\"\"\"\n",
    "    records = []\n",
    "    \n",
    "    if mode == \"desktop\":\n",
    "        vp = random.choice(DESKTOP_VIEWPORTS)\n",
    "        context = await browser.new_context(viewport=vp)\n",
    "        viewport_h = vp[\"height\"]\n",
    "        viewport_w = vp[\"width\"]\n",
    "        device_name = \"\"\n",
    "    else:\n",
    "        device = pw.devices[random.choice(MOBILE_DEVICES)]\n",
    "        context = await browser.new_context(**device)\n",
    "        viewport_h = device[\"viewport\"][\"height\"]\n",
    "        viewport_w = device[\"viewport\"][\"width\"]\n",
    "        device_name = device.get(\"user_agent\", \"\").split(\"/\")[0] or random.choice(MOBILE_DEVICES)\n",
    "\n",
    "    page = await context.new_page()\n",
    "    status = \"ok\"\n",
    "    \n",
    "    try:\n",
    "        try:\n",
    "            await page.goto(url, wait_until=\"load\", timeout=timeout)\n",
    "        except PWTimeoutError:\n",
    "            status = \"timeout\"\n",
    "            print(f\"[warn] {slug} ({mode}): load timed out, continuing anyway\")\n",
    "\n",
    "        try:\n",
    "            await page.wait_for_load_state(\"networkidle\", timeout=8000)\n",
    "        except PWTimeoutError:\n",
    "            pass\n",
    "        await page.wait_for_timeout(400)\n",
    "\n",
    "        try:\n",
    "            scroll_height = await page.evaluate(\n",
    "                \"Math.max(document.body.scrollHeight, document.documentElement.scrollHeight)\"\n",
    "            )\n",
    "        except Exception:\n",
    "            scroll_height = viewport_h\n",
    "\n",
    "        max_scroll = max(0, scroll_height - viewport_h)\n",
    "        positions = pick_scroll_positions(max_scroll, viewport_h, count)\n",
    "\n",
    "        for y in positions[:count]:\n",
    "            try:\n",
    "                await page.evaluate(f\"window.scrollTo(0, {y})\")\n",
    "            except Exception:\n",
    "                pass\n",
    "            await page.wait_for_timeout(random.randint(350, 700))\n",
    "\n",
    "            idx = next_index(slug, mode)\n",
    "            fname = f\"{slug}_{mode}_{idx:03d}.png\"\n",
    "            fpath = out_dir / fname\n",
    "            \n",
    "            try:\n",
    "                await page.screenshot(path=str(fpath))\n",
    "                records.append(ScreenshotRecord(\n",
    "                    filename=fname,\n",
    "                    slug=slug,\n",
    "                    mode=mode,\n",
    "                    index=idx,\n",
    "                    url=url,\n",
    "                    scroll_y=y,\n",
    "                    viewport_width=viewport_w,\n",
    "                    viewport_height=viewport_h,\n",
    "                    device_name=device_name,\n",
    "                    captured_at=datetime.utcnow().isoformat() + \"Z\",\n",
    "                    status=status,\n",
    "                ))\n",
    "            except Exception as e:\n",
    "                print(f\"[warn] {slug} ({mode}): screenshot failed at y={y}: {e}\")\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f\"[error] {slug} ({mode}): {e}\")\n",
    "    finally:\n",
    "        await context.close()\n",
    "\n",
    "    return records\n",
    "\n",
    "\n",
    "async def process_site(site, sem, pw, out_dir: Path) -> List[ScreenshotRecord]:\n",
    "    raw_slug = site.get(\"slug\") or site.get(\"title\") or \"\"\n",
    "    slug = sanitize(raw_slug)\n",
    "    url = site.get(\"live_url\")\n",
    "    all_records = []\n",
    "\n",
    "    if not url:\n",
    "        print(f\"[skip] {slug or '(unnamed)'}: no live_url\")\n",
    "        return all_records\n",
    "\n",
    "    async with sem:\n",
    "        n_total = random.randint(MIN_SHOTS, MAX_SHOTS)\n",
    "        ratio = min(1.0, max(0.0, MOBILE_RATIO + random.uniform(-0.08, 0.08)))\n",
    "        mobile_count = min(n_total, round(n_total * ratio))\n",
    "        if n_total >= 2:\n",
    "            mobile_count = min(max(mobile_count, 1), n_total - 1) if random.random() < 0.9 else mobile_count\n",
    "        desktop_count = n_total - mobile_count\n",
    "\n",
    "        browser = None\n",
    "        try:\n",
    "            browser = await pw.chromium.launch(headless=HEADLESS)\n",
    "            if desktop_count > 0:\n",
    "                all_records += await capture_viewport(\n",
    "                    browser, pw, slug, url, \"desktop\", desktop_count,\n",
    "                    TIMEOUT, HEADLESS, out_dir\n",
    "                )\n",
    "            if mobile_count > 0:\n",
    "                all_records += await capture_viewport(\n",
    "                    browser, pw, slug, url, \"mobile\", mobile_count,\n",
    "                    TIMEOUT, HEADLESS, out_dir\n",
    "                )\n",
    "\n",
    "            saved = len(all_records)\n",
    "            if saved == 0:\n",
    "                print(f\"[fail] {slug}: unreachable or produced no screenshots ({url})\")\n",
    "            else:\n",
    "                print(f\"[ok]   {slug}: saved {saved} screenshot(s) \"\n",
    "                      f\"({desktop_count} desktop / {mobile_count} mobile)\")\n",
    "        except Exception as e:\n",
    "            print(f\"[error] {slug}: {e} ({url})\")\n",
    "        finally:\n",
    "            if browser is not None:\n",
    "                await browser.close()\n",
    "\n",
    "    return all_records\n",
    "\n",
    "print(\"✅ Screenshot engine ready\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5️⃣ Run the Builder\n",
    "\n",
    "⚠️ **Make sure `projects.json` is uploaded** before running this cell.\n",
    "\n",
    "It will:\n",
    "1. Read `projects.json`\n",
    "2. Capture screenshots for every site\n",
    "3. Save PNGs to `./dataset/`\n",
    "4. Write `dataset_metadata.csv` with all image metadata"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "async def run_builder():\n",
    "    sites = load_websites(INPUT_FILE)\n",
    "    if LIMIT:\n",
    "        sites = sites[:LIMIT]\n",
    "\n",
    "    out_dir = Path(OUTPUT_DIR)\n",
    "    out_dir.mkdir(parents=True, exist_ok=True)\n",
    "    init_counters(out_dir)\n",
    "\n",
    "    sem = asyncio.Semaphore(CONCURRENCY)\n",
    "    all_records: List[ScreenshotRecord] = []\n",
    "\n",
    "    async with async_playwright() as pw:\n",
    "        tasks = [process_site(site, sem, pw, out_dir) for site in sites]\n",
    "        results = await asyncio.gather(*tasks)\n",
    "        for recs in results:\n",
    "            all_records.extend(recs)\n",
    "\n",
    "    # ── Write CSV ──\n",
    "    if all_records:\n",
    "        df = pd.DataFrame([asdict(r) for r in all_records])\n",
    "        df.to_csv(CSV_FILE, index=False)\n",
    "        print(f\"\\n📊 CSV saved: {CSV_FILE}\")\n",
    "        print(f\"   Rows: {len(df)}\")\n",
    "        print(f\"   Columns: {list(df.columns)}\")\n",
    "        print(\"\\n   Preview:\")\n",
    "        display(df.head(10))\n",
    "    else:\n",
    "        print(\"\\n⚠️ No screenshots were captured.\")\n",
    "\n",
    "    total_pngs = len(list(out_dir.glob(\"*.png\")))\n",
    "    print(f\"\\n📁 Total PNG screenshot(s) in {out_dir}: {total_pngs}\")\n",
    "    return all_records\n",
    "\n",
    "# ── Execute ──\n",
    "records = await run_builder()"
   ]
  },
  {
   "cell_type": "markdown",
